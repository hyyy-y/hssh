/* hssh global dark theme.
 * Base colors follow the terminal palette (#0c0c0c background, #cccccc text)
 * so chrome and terminal blend together. Selection accent: #264f78.
 */

QWidget {
    background-color: #252526;
    color: #cccccc;
    font-size: 13px;
}

/* ---------- main window / docks ---------- */

QMainWindow::separator {
    background: #1b1b1c;
    width: 2px;
    height: 2px;
}

QDockWidget {
    color: #bbbbbb;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: #2d2d30;
    padding: 5px 8px;
    border-bottom: 1px solid #1b1b1c;
    font-weight: bold;
}

QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #3e3e42;
}

/* ---------- menu bar / menus ---------- */

QMenuBar {
    background-color: #2d2d30;
    border-bottom: 1px solid #1b1b1c;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background: #3e3e42;
}

QMenu {
    background-color: #2d2d30;
    border: 1px solid #1b1b1c;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 20px;
}

QMenu::item:selected {
    background-color: #264f78;
}

QMenu::item:disabled {
    color: #6a6a6a;
}

QMenu::separator {
    height: 1px;
    background: #1b1b1c;
    margin: 4px 8px;
}

/* ---------- tool bar ---------- */

QToolBar {
    background: #2d2d30;
    border: none;
    border-bottom: 1px solid #1b1b1c;
    spacing: 4px;
    padding: 3px;
}

QToolBar::separator {
    background: #1b1b1c;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px 8px;
}

QToolButton:hover {
    background: #3e3e42;
    border-color: #4a4a4e;
}

QToolButton:pressed, QToolButton:checked {
    background: #264f78;
}

QToolButton:disabled {
    color: #6a6a6a;
}

QToolButton::menu-indicator {
    image: none;
    width: 0;
}

/* ---------- tab widget ---------- */

QTabWidget::pane {
    border: none;
    background: #1b1b1c;
}

QTabBar {
    background: #252526;
}

QTabBar::tab {
    background: #2d2d30;
    color: #9a9a9a;
    padding: 6px 14px;
    margin-right: 1px;
    border-top: 2px solid transparent;
}

QTabBar::tab:selected {
    background: #1b1b1c;
    color: #e8e8e8;
    border-top: 2px solid #007acc;
}

QTabBar::tab:hover:!selected {
    background: #3e3e42;
    color: #cccccc;
}

QTabBar::close-button {
    image: none;
    background: transparent;
}

/* ---------- item views (tree/table) ---------- */

QTreeView, QTableView, QListView {
    background-color: #1b1b1c;
    alternate-background-color: #232324;
    border: none;
    outline: none;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    show-decoration-selected: 1;
}

QTreeView::item, QTableView::item, QListView::item {
    padding: 3px 4px;
    border: none;
}

QTreeView::item:hover, QTableView::item:hover, QListView::item:hover {
    background: #2d333b;
}

QTreeView::item:selected, QTableView::item:selected, QListView::item:selected {
    background: #264f78;
}

QTreeView::branch {
    background: #1b1b1c;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #bbbbbb;
    border: none;
    border-right: 1px solid #1b1b1c;
    border-bottom: 1px solid #1b1b1c;
    padding: 5px 8px;
}

QHeaderView::section:hover {
    background-color: #3e3e42;
}

/* ---------- inputs ---------- */

QLineEdit, QComboBox, QSpinBox {
    background-color: #1b1b1c;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    padding: 4px 6px;
    selection-background-color: #264f78;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #007acc;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #2d2d30;
    border: 1px solid #1b1b1c;
    selection-background-color: #264f78;
}

/* ---------- buttons ---------- */

QPushButton {
    background-color: #333338;
    border: 1px solid #4a4a4e;
    border-radius: 3px;
    padding: 5px 14px;
}

QPushButton:hover {
    background-color: #3e3e42;
}

QPushButton:pressed {
    background-color: #264f78;
}

QPushButton:default {
    border-color: #007acc;
}

QPushButton:disabled {
    color: #6a6a6a;
    background-color: #2d2d30;
}

QDialogButtonBox QPushButton {
    min-width: 70px;
}

/* ---------- scroll bars ---------- */

QScrollBar:vertical {
    background: #1b1b1c;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #424242;
    min-height: 24px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #4f4f4f;
}

QScrollBar:horizontal {
    background: #1b1b1c;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #424242;
    min-width: 24px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #4f4f4f;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------- status bar / progress ---------- */

QStatusBar {
    background: #007acc;
    color: #ffffff;
}

QStatusBar QLabel {
    background: transparent;
    color: #ffffff;
    padding: 0 8px;
}

QStatusBar::item {
    border: none;
}

QProgressBar {
    background: #1b1b1c;
    border: 1px solid #3e3e42;
    border-radius: 3px;
    text-align: center;
    color: #cccccc;
}

QProgressBar::chunk {
    background: #007acc;
    border-radius: 2px;
}

/* ---------- misc ---------- */

QSplitter::handle {
    background: #1b1b1c;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background: #007acc;
}

QLabel {
    background: transparent;
}

QToolTip {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #4a4a4e;
    padding: 4px 6px;
}

QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 3px;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #9a9a9a;
}

QCheckBox, QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}
